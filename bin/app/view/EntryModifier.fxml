<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="350.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.EntryModifierController">
   <children>
      <Label text="MODIFYING DATA" />
      <GridPane VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Patient Id" GridPane.rowIndex="1" />
            <Label text="No Facture " GridPane.rowIndex="2" />
            <Label text="Exam" GridPane.rowIndex="3" />
            <Label text="Surgery" GridPane.rowIndex="4" />
            <Label text="Consommable" GridPane.rowIndex="5" />
            <Label text="Exam / Surgery date" GridPane.rowIndex="6" />
            <TextField fx:id="nofacture" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="exam" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="surgery" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <ComboBox fx:id="patientId" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="consommable" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <DatePicker fx:id="exDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <Button fx:id="save" mnemonicParsing="false" onAction="#saveModifications" text="Save" GridPane.halignment="CENTER" GridPane.rowIndex="7" />
            <Button mnemonicParsing="false" onAction="#cancelModifications" text="Cancel" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="7" />
            <Label text="Entry ID" />
            <Label fx:id="entryId" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

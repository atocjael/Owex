<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8">
   <children>
      <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="Optic Nerve Head">
               <content>
                  <VBox maxHeight="1.7976931348623157E308" prefWidth="600.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <Label text="Margins" />
                        <CheckBox mnemonicParsing="false" text="Clear" />
                        <CheckBox mnemonicParsing="false" text="Hazy" />
                        <CheckBox mnemonicParsing="false" text="Elevated" />
                     </children>
                  </VBox>
               </content>
          </Tab>
          <Tab text="Overall retina">
               <content>
                  <VBox maxHeight="1.7976931348623157E308" prefHeight="227.0" prefWidth="600.0" spacing="10.0">
                     <children>
                        <Label text="Color:" />
                        <CheckBox mnemonicParsing="false" text="Pink rose">
                           <VBox.margin>
                              <Insets left="10.0" />
                           </VBox.margin>
                        </CheckBox>
                        <GridPane>
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label text="Specify another color" />
                              <TextField GridPane.columnIndex="1" />
                           </children>
                           <VBox.margin>
                              <Insets left="10.0" />
                           </VBox.margin>
                        </GridPane>
                        <Label text="Deposits" />
                        <CheckBox mnemonicParsing="false" text="Hard exsudats" />
                        <CheckBox mnemonicParsing="false" text="Cotton wool" />
                        <CheckBox mnemonicParsing="false" text="CheckBox" />
                        <CheckBox mnemonicParsing="false" text="CheckBox" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
          </Tab>
            <Tab text="Macula">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
              </content>
            </Tab>
            <Tab text="Periphery">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
              </content>
            </Tab>
            <Tab text="Vessels">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>

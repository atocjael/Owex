<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.UserAdderController">
   <children>
      <Label text="ADD USER INFOS" />
      <GridPane>
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <children>
            <Label text="Nom" />
            <Label text="Prenom" GridPane.rowIndex="1" />
            <Label text="Email" GridPane.rowIndex="2" />
            <Label text="Pseudo" GridPane.rowIndex="3" />
            <Label text="Password" GridPane.rowIndex="4" />
            <Label text="Telephone" GridPane.rowIndex="5" />
            <Label text="Role" GridPane.rowIndex="6" />
            <Label text="Title" GridPane.rowIndex="7" />
            <Label text="\%  sur les examens" GridPane.rowIndex="8" />
            <Label text="\% sur les operations" GridPane.rowIndex="9" />
            <TextField fx:id="userNom" GridPane.columnIndex="1" />
            <TextField fx:id="userPrenom" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="userEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="userPseudo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="userPass" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="userTel" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <ComboBox fx:id="userRole" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <ComboBox fx:id="userTitle" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
            <ComboBox fx:id="userEx" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
            <ComboBox fx:id="userOp" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="9" />
            <Button fx:id="add" mnemonicParsing="false" onAction="#addUser" text="Save" GridPane.halignment="CENTER" GridPane.rowIndex="11" />
            <Button mnemonicParsing="false" onAction="#cancel" text="Cancel" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="11" />
         </children>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

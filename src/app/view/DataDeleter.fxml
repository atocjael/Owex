<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.DataDeleterController">
   <children>
      <Label text="DELETING DATA">
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Label>
      <TableView fx:id="entryTable" prefWidth="200.0" VBox.vgrow="SOMETIMES">
        <columns>
            <TableColumn fx:id="check" prefWidth="75.0" text="Check" />
          <TableColumn fx:id="patientId" prefWidth="75.0" text="Patient Id" />
          <TableColumn fx:id="exam" prefWidth="75.0" text="Exam" />
            <TableColumn fx:id="surgery" prefWidth="75.0" text="Surgery" />
            <TableColumn fx:id="date" prefWidth="75.0" text="Date" />
        </columns>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <GridPane>
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button mnemonicParsing="false" onAction="#deleteSelectedEntries" text="Delete" GridPane.halignment="CENTER" />
            <Button mnemonicParsing="false" onAction="#cancelDelete" text="Cancel" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

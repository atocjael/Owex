<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.CheckComboBox?>

<VBox prefHeight="322.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.ExamenConclusionController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label text="Conclusion de l'examen" />
      <CheckComboBox fx:id="conclusion" maxWidth="1.7976931348623157E308" />
      <Label text="Recommendations " />
      <TextArea fx:id="recommendation" prefHeight="75.0" prefWidth="580.0" />
      <GridPane prefHeight="63.0" prefWidth="591.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nom de l'examinateur" />
            <TextField fx:id="examinateur" prefHeight="30.0" prefWidth="290.0" GridPane.columnIndex="1" />
         </children>
      </GridPane>
      <ButtonBar prefHeight="30.0" prefWidth="200.0">
        <buttons>
          <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#saveConclusion" prefHeight="39.0" text="Save" />
        </buttons>
      </ButtonBar>
   </children>
</VBox>

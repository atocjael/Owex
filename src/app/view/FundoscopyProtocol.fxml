<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="800.0">
         <center>
            <TabPane prefHeight="545.0" prefWidth="800.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
              <tabs>
                  <Tab text="Patient Identification">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="First and Last name" />
                                    <TextField GridPane.columnIndex="1" />
                                    <Label text="Indication" GridPane.rowIndex="1" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Gender" GridPane.rowIndex="2" />
                                    <ComboBox prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Age" GridPane.rowIndex="3" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                 </children>
                              </GridPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
                <Tab text="Optic Nerve Head">
                     <content>
                        <SplitPane dividerPositions="0.5" prefHeight="160.0" prefWidth="200.0">
                           <items>
                              <VBox maxHeight="1.7976931348623157E308" prefWidth="600.0" spacing="10.0">
                                 <children>
                                    <Label text="Disc size" />
                                    <RadioButton mnemonicParsing="false" text="Small" />
                                    <RadioButton mnemonicParsing="false" text="Normal" />
                                    <RadioButton mnemonicParsing="false" text="Large" />
                                    <Label text="Margins" />
                                    <RadioButton mnemonicParsing="false" text="Sharp and well-defined" />
                                    <RadioButton mnemonicParsing="false" text="Hazy" />
                                    <RadioButton mnemonicParsing="false" text="Elevated" />
                                    <Label text=" Neuro retinal rim color" />
                                    <RadioButton mnemonicParsing="false" text="Pink" />
                                    <RadioButton mnemonicParsing="false" text="Pale" />
                                    <RadioButton mnemonicParsing="false" text="Hyperemia" />
                                    <Label text="Cup" />
                                    <GridPane>
                                       <children>
                                          <Label text="Vertical C/D ratio" />
                                          <TextField GridPane.columnIndex="1" />
                                          <Label text="Horizontal C/D ratio" GridPane.rowIndex="1" />
                                          <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                    </GridPane>
                                    <CheckBox mnemonicParsing="false" text="Asymmetry &gt; 0.2 between OD and OS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                 <children>
                                    <Label text="Others signs" />
                                    <CheckBox mnemonicParsing="false" text="Defects of RFNL  (Red free)" />
                                    <CheckBox mnemonicParsing="false" text="Undermining of vessels " />
                                    <CheckBox mnemonicParsing="false" text="Baring of vessels" />
                                    <CheckBox mnemonicParsing="false" text="Nasal displacement" />
                                    <CheckBox mnemonicParsing="false" text="Bayoneting sign" />
                                    <CheckBox mnemonicParsing="false" text="Laminar dot sign" />
                                    <CheckBox mnemonicParsing="false" text="Beta zone" />
                                    <CheckBox mnemonicParsing="false" text="Alpha zone" />
                                    <CheckBox mnemonicParsing="false" text="Disc hemorrage" />
                                    <CheckBox mnemonicParsing="false" text="ISNT Rule  not respected" />
                                    <CheckBox mnemonicParsing="false" text="Notching" />
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                           </items>
                        </SplitPane>
                     </content>
                </Tab>
                <Tab text="Overall retina">
                     <content>
                        <VBox maxHeight="1.7976931348623157E308" prefHeight="227.0" prefWidth="600.0" spacing="10.0">
                           <children>
                              <Label text="Color:" />
                              <CheckBox mnemonicParsing="false" text="Pink rose">
                                 <VBox.margin>
                                    <Insets left="10.0" />
                                 </VBox.margin>
                              </CheckBox>
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="Specify another color" />
                                    <TextField GridPane.columnIndex="1" />
                                 </children>
                                 <VBox.margin>
                                    <Insets left="10.0" />
                                 </VBox.margin>
                              </GridPane>
                              <Label text="Deposits" />
                              <CheckBox mnemonicParsing="false" text="Hard exsudats" />
                              <CheckBox mnemonicParsing="false" text="Cotton wool" />
                              <CheckBox mnemonicParsing="false" text="CheckBox" />
                              <CheckBox mnemonicParsing="false" text="CheckBox" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                </Tab>
                  <Tab text="Macula">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
                  <Tab text="Periphery">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
                  <Tab text="Vessels">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
              </tabs>
            </TabPane>
         </center>
         <bottom>
            <VBox prefHeight="37.0" prefWidth="800.0" style="-fx-background-color: grey;" BorderPane.alignment="CENTER">
               <children>
                  <GridPane>
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="109.0" text="Next &gt;&gt;&gt;" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.valignment="CENTER" />
                     </children>
                  </GridPane>
               </children>
            </VBox>
         </bottom>
      </BorderPane>
   </children>
</VBox>

<VBox prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <BorderPane prefHeight="550.0" prefWidth="700.0">
         <center>
            <TabPane prefHeight="550.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
              <tabs>
                  <Tab text="Patient Identification">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="First and Last name" />
                                    <TextField GridPane.columnIndex="1" />
                                    <Label text="Indication" GridPane.rowIndex="1" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Gender" GridPane.rowIndex="2" />
                                    <ComboBox maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Age" GridPane.rowIndex="3" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Eye" GridPane.rowIndex="4" />
                                    <ComboBox maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                 </children>
                              </GridPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
                <Tab text="Optic Nerve Head">
                     <content>
                        <SplitPane dividerPositions="0.5" prefHeight="484.0" prefWidth="709.0">
                           <items>
                              <VBox maxHeight="1.7976931348623157E308" prefWidth="600.0" spacing="10.0">
                                 <children>
                                    <Label text="Disc size" />
                                    <RadioButton mnemonicParsing="false" text="Small" />
                                    <RadioButton mnemonicParsing="false" text="Normal" />
                                    <RadioButton mnemonicParsing="false" text="Large" />
                                    <Label text="Margins" />
                                    <RadioButton mnemonicParsing="false" text="Sharp and well-defined" />
                                    <RadioButton mnemonicParsing="false" text="Hazy" />
                                    <RadioButton mnemonicParsing="false" text="Elevated" />
                                    <Label text=" Neuro retinal rim color" />
                                    <RadioButton mnemonicParsing="false" text="Pink" />
                                    <RadioButton mnemonicParsing="false" text="Pale" />
                                    <RadioButton mnemonicParsing="false" text="Hyperemia" />
                                    <Label text="Cup" />
                                    <GridPane>
                                       <children>
                                          <Label text="Vertical C/D ratio" />
                                          <TextField GridPane.columnIndex="1" />
                                          <Label text="Horizontal C/D ratio" GridPane.rowIndex="1" />
                                          <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                    </GridPane>
                                    <CheckBox mnemonicParsing="false" text="Asymmetry &gt; 0.2 between OD and OS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" stylesheets="@../sources/grid.css">
                                 <children>
                                    <Label text="Others signs" />
                                    <CheckBox mnemonicParsing="false" text="Defects of RFNL  (Red free)">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="RNFL defects appear as darker areas (black or dark grey) compared to the surrounding healthy tissue.They often take the form of a &quot;wedge&quot; or &quot;slit&quot; that starts at the edge of the optic nerve and widens as it moves outward." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Undermining of vessels ">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="The excavation (cup) doesn't just go down; it eats away at the sides underneath the neuroretinal rim. Imagine a cliff where the ocean has eroded the base. The top of the cliff now &quot;overhangs&quot; a hollow space. That hollow space is the undermining." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Baring of vessels">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="A vessel no longer touches the neural rim because the tissue underneath has eroded. It looks like it's &quot;floating&quot; over a space." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Nasal displacement">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="The movement of the central retinal vessels toward the nasal side (toward the nose) of the optic disc." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Bayoneting sign">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="As a vessel comes from the retina toward the center of the nerve, it reaches the edge of the cup and has to make a sharp, double turn to follow the new, hollowed-out shape of the nerve.The vessel appears to &quot;disappear&quot; under the overhanging rim and then reappears at the bottom of the cup, shifted to one side" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                    </CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Laminar dot sign">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Small greyish dots at the bottom of the optic cup." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Beta zone">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="A region of complete atrophy of the Retinal Pigment Epithelium (RPE) and the choriocapillaris. It sits inside Zone Alpha, touching the margin of the optic disc" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Alpha zone">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Irregular pigmentation of the RPE at the outer periphery of the optic disc.- (dark and light mottling of the RPE)." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Disc hemorrage">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="t typically looks like a tiny red splinter, flame, or streak at the edge of the optic nerve head (the disc).  It is most frequently found in the infero-temporal or supero-temporal sectors." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="ISNT Rule  violation">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="In a healthy eye, the thickness of the neuroretinal rim (the pinkish tissue of the optic disc) follows a specific hierarchy from thickest to thinnest: I – Inferior (Thickest) S – Superior N – Nasal T – Temporal (Thinnest)" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Notching">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Focal, localized loss of the neuroretinal rim. - A &quot;bite-like&quot; defect or a notch in the rim localized at Inferior-temporal or superior-temporal poles." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Neovascularisation on the disc">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Unlike a simple bleed, NVD looks like a delicate, disorganized &quot;frond&quot; or meshwork of tiny, loops of vessels." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font></Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                           </items>
                        </SplitPane>
                     </content>
                </Tab>
                  <Tab text="Macula">
                     <content>
                        <SplitPane dividerPositions="0.5" prefHeight="524.0" prefWidth="825.0">
                           <items>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                 <children>
                                    <Label text="Physiological Landmarks &amp; Contour" />
                                    <Label text="Foveal Reflex">
                                       <tooltip>
                                          <Tooltip text="A bright, glistening &quot;white dot.&quot;" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></Label>
                                    <RadioButton mnemonicParsing="false" text="Present" />
                                    <RadioButton mnemonicParsing="false" text="Absent" />
                                    <Label text="Retinal Profile" />
                                    <RadioButton mnemonicParsing="false" text="Flat" />
                                    <RadioButton mnemonicParsing="false" text="Elevation" />
                                    <RadioButton mnemonicParsing="false" text="Depression" />
                                    <Label text="ILM Reflex">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="A bright, pinpoint, or oval glint of light reflecting off the central macula (fovea). It is very sharp and prominent in children and young adults because their ILM is very smooth. It naturally fades or becomes &quot;dull&quot; with age." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></Label>
                                    <RadioButton mnemonicParsing="false" text="Cellophane metallic glint " />
                                    <RadioButton mnemonicParsing="false" text="Satin-like sheen" />
                                    <Label text="PVD" />
                                    <RadioButton mnemonicParsing="false" text="Absent" />
                                    <RadioButton mnemonicParsing="false" text="Partial with traction" />
                                    <RadioButton mnemonicParsing="false" text="Partial" />
                                    <RadioButton mnemonicParsing="false" text="Complete">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="The Weiss Ring: This is the definitive clinical sign. It is a circular, translucent floating opacity that represents the detached attachment point from the optic nerve head." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></RadioButton>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                 <children>
                                    <Label text="Edema / Liquid" />
                                    <CheckBox mnemonicParsing="false" text="Cystoid spaces">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="The observation of Cystoid Macular Edema (CME) on fundoscopy often shows a thickened macula with a loss of the normal foveal reflex. In advanced cases, fluid accumulates in a characteristic 'flower petal' (petaloid) pattern due to the arrangement of Henle’s nerve fibers." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Serous Retinal Detachment">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text=" A serous retinal detachment often presents as a smooth, dome-shaped bubble. A major clinical sign is shifting fluid, where the detachment changes position based on the patient's head posture due to simple gravity." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Pigment Epithelial Detachment">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Appears as a well-demarcated, dome-shaped elevation. It often has a translucent or orange-yellow hue and may &quot;glow&quot; or transilluminate when the light beam is placed over it. Drusenoid PED: Typically presents as a yellow-white elevation with scalloped or &quot;irregular&quot; borders. You might see a &quot;triradiate&quot; or stellate pattern of brownish pigment on its surface. Fibrovascular PED: Often looks more irregular and less &quot;smooth&quot; than serous types. Look for signs of activity like yellow exudates or subretinal hemorrhage (blood) at the margins" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <Label text="Deposits  &amp; Atrophy" />
                                    <CheckBox mnemonicParsing="false" text="Hard drusens">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Yellow-white extracellular deposits that accumulate between the retinal pigment epithelium (RPE) and Bruch’s membrane. Small (&lt;63 µm), round, and discrete with very sharp borders" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Soft drusens ">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Yellow-white extracellular deposits that accumulate between the retinal pigment epithelium (RPE) and Bruch’s membrane. Larger (&gt;125 µm), amorphous, and pale yellow with fuzzy or indistinct borders." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Cuticular drusens ">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Yellow-white extracellular deposits that accumulate between the retinal pigment epithelium (RPE) and Bruch’s membrane. Numerous tiny, tiny &quot;pinpoint&quot; yellow lesions." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip>
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Hard Exudates">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Small, yellowish-white lipid deposits with sharp margins that form within the retinal layers. Unlike drusen (which are beneath the RPE), hard exudates are intraretinal, typically located in the outer plexiform layer." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Geographic atrophy">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Sharply Demarcated Areas: Patches of the retina appear as &quot;islands&quot; of depigmentation with very clear, well-defined borders. Visible Choroidal Vessels: Because the pigmented RPE layer is missing, you can easily see the larger, underlying choroidal blood vessels through the atrophic patch. Color Change: These areas typically appear lighter, pale pink, or yellowish-white compared to the surrounding healthy retina." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Pigment clumping" />
                                    <CheckBox mnemonicParsing="false" text="Macular Nevus">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Typically appears as a flat or minimally elevated, slate-gray to brown lesion located deep within the choroid. It is characterized by well-demarcated but soft borders that blend into the surrounding fundus, often reaching a diameter of several millimeters." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Subretinal Hemorrhage">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="bright red to deep maroon lesion with irregular, scalloped, or diffuse borders. Because the blood is located deep to the neurosensory retina, the retinal vasculature is clearly visible passing over the surface of the hemorrhage" wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Full thickness macular hole ">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text=" Appears as a well-defined, round, red spot in the center of the macula. A surrounding grayish halo or &quot;cuff&quot; indicates fluid that has seeped under the edges of the hole, causing a shallow local detachment." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Lamellar Hole">
                                       <cursor>
                                          <Cursor fx:constant="HAND" />
                                       </cursor>
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="a partial-thickness defect where the inner layers of the fovea are lost or split, but the outer retinal layers (including photoreceptors) remain intact. IIt typically appears as a round or oval reddish lesion at the center of the macula, slightly darker than the surrounding tissue." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                           </items>
                        </SplitPane>
                     </content>
                  </Tab>
                <Tab text="Overall retina">
                     <content>
                        <VBox maxHeight="1.7976931348623157E308" prefHeight="227.0" prefWidth="600.0" spacing="10.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <Label text="Background" />
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="Transparency" />
                                    <RadioButton mnemonicParsing="false" text="Normal" GridPane.columnIndex="1" />
                                    <RadioButton mnemonicParsing="false" text="Hazy" GridPane.columnIndex="3" />
                                 </children>
                              </GridPane>
                              <GridPane>
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="Color" />
                                    <RadioButton mnemonicParsing="false" text="Normal" GridPane.columnIndex="1" />
                                    <RadioButton mnemonicParsing="false" text="Pale" GridPane.columnIndex="2" />
                                    <RadioButton mnemonicParsing="false" text="Tigroid" GridPane.columnIndex="3" />
                                 </children>
                              </GridPane>
                              <Label text="Diabetic / ischemic vascular signs" />
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <CheckBox mnemonicParsing="false" text="Microaneurysms">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Small, discrete red dots on the surface of the retina. They are typically the earliest visible sign of diabetic retinopathy. They look like tiny, round, or circular red dots. While most are bright red, some may appear yellowish if they have undergone internal changes like hyalinization." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Cotton Wool Spots" GridPane.rowIndex="1">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Also called &quot;soft exudates&quot;,  they present as superficial, whitish-gray patches with fuzzy, ill-defined borders that resemble small tufts of cotton or clouds. Unlike hard exudates, they are opaque and slightly elevated because they occur in the nerve fiber layer, often appearing to obscure underlying retinal vessels. " wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Dot and Blot hemorrhage" GridPane.rowIndex="2">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Dark red, circular, or irregular &quot;blobs&quot; located deep within the retinal tissue. Their characteristic rounded shape occurs because the escaped blood is physically compressed by the densely packed neurons of the inner nuclear and outer plexiform layers." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <TextField GridPane.columnIndex="1" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <CheckBox mnemonicParsing="false" text="Neovascularisation else where" GridPane.rowIndex="4">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Appears as delicate, disorganized &quot;fronds&quot; or lacy networks of tiny, irregular blood vessels branching from existing retinal veins. These new vessels are typically found more than one disc diameter away from the optic nerve head and often grow along the surface of the retina or extend into the vitreous." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <CheckBox mnemonicParsing="false" text="Flame-Shaped Hemorrhages" GridPane.rowIndex="3">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text=" Bright red, splinter-like streaks within the superficial nerve fiber layer (RNFL)." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                 </children>
                              </GridPane>
                              <CheckBox mnemonicParsing="false" text="Boat-shaped/Preretinal hemorrhage">
                                 <tooltip>
                                    <Tooltip maxWidth="350.0" text="Large, distinct pools of bright red blood trapped between the retina and the vitreous (subhyaloid space). Because the blood is not confined by retinal tissue, gravity causes the red blood cells to settle at the bottom, creating a characteristic straight horizontal top border and a curved, rounded bottom." wrapText="true">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Tooltip>
                                 </tooltip></CheckBox>
                              <CheckBox mnemonicParsing="false" text="Venous beading / looping">
                                 <tooltip>
                                    <Tooltip maxWidth="350.0" text="Structural venous deformities that signify severe retinal ischemia and a high risk of progression to proliferative disease. Venous beading is characterized by focal, irregular areas of dilation and narrowing, giving the vessel a &quot;string of sausages&quot; or beaded appearance, while venous looping occurs when a vein deviates into a sharp, omega-shaped or circular turn." wrapText="true">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Tooltip>
                                 </tooltip></CheckBox>
                              <CheckBox mnemonicParsing="false" text="IRMA">
                                 <tooltip>
                                    <Tooltip maxWidth="350.0" text="Fine, tortuous, &quot;wiry&quot; red lines that form a complex, lacy network within the retinal tissue. These vessels are typically found in the mid-periphery, often adjacent to areas of capillary non-perfusion or near cotton wool spots, acting as intraretinal shunts. Unlike the delicate &quot;fronds&quot; of neovascularization, IRMA vessels have sharper, better-defined outlines, are slightly larger in caliber, and are strictly contained within the retina—they do not cross over major retinal vessels or grow into the vitreous." wrapText="true">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Tooltip>
                                 </tooltip></CheckBox>
                              <Label text="Others signs" />
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <CheckBox mnemonicParsing="false" text="Emboli">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Small, distinct particles trapped within the retinal arterioles, typically categorized into three main types based on their appearance and source. Cholesterol emboli (Hollenhorst plaques) are the most common and appear as highly refractile, bright yellow or orange crystals usually located at vessel bifurcations; they often originate from carotid artery atherosclerosis. Calcific emboli are dull, chalky white, and larger, typically lodging in major vessels near the optic disc and suggesting a source from calcified heart valves. Platelet-fibrin emboli present as dull, grayish-white, elongated &quot;plugs&quot; that may move through the circulation or appear in &quot;showers,&quot; often associated with mural thrombi in the carotid system or heart." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Infectious  / inflammatory lesions" GridPane.rowIndex="1">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="Typically present as creamy yellow or whitish patches on the retina, with their appearance varying significantly based on whether the condition is active or chronic. Active Lesions: These appear as creamy, yellowish-white patches with fuzzy, blurred borders due to surrounding retinal edema. They are often accompanied by &quot;vitritis&quot;—inflammatory cells in the vitreous that create a &quot;haze&quot; or &quot;headlight in the fog&quot; effect. Inactive/Healed Lesions: Chronic lesions develop into sharply demarcated scars with distinct borders. These scars often show pigmentation (black clumping) at the edges and areas of &quot;punched-out&quot; atrophy where the underlying choroidal vessels may become visible." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <CheckBox mnemonicParsing="false" text="Choroid nevus" GridPane.rowIndex="2">
                                       <tooltip>
                                          <Tooltip maxWidth="350.0" text="A flat or minimally elevated, well-defined lesion with a characteristic slate-gray or brown color and feathered borders. Key indicators of a benign, long-standing lesion include the presence of overlying drusen and the absence of symptoms like flashes or vision loss. To differentiate it from a melanoma, clinicians look for &quot;red flag&quot; features such as a thickness greater than 2 mm, the presence of subretinal fluid, or the appearance of orange pigment (lipofuscin) on the surface." wrapText="true">
                                             <font>
                                                <Font size="14.0" />
                                             </font>
                                          </Tooltip>
                                       </tooltip></CheckBox>
                                    <TextField GridPane.columnIndex="1" />
                                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                 </children>
                              </GridPane>
                           </children>
                        </VBox>
                     </content>
                </Tab>
